# 1) Vapi dashboard -> API Keys
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# 2) Leave empty: ADAM is created automatically on first start
VAPI_ASSISTANT_ID=
# 3) Needed for calling parents (Vapi -> Phone Numbers -> copy ID)
VAPI_PHONE_NUMBER_ID=
# 4) Public https URL (ngrok/Render). REQUIRED for attendance lookups, saving reasons, call logs
PUBLIC_URL=
# Password for /admin.html
ADMIN_KEY=change-me
PORT=3000
